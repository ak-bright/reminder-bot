# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# --- AI (needed from M4) ---
ANTHROPIC_API_KEY=
MODEL_PARSER=claude-haiku-5-5
MODEL_ASSISTANT=claude-sonnet-5-5
AI_DAILY_LIMIT=30
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=1024

# --- Database ---
# SQLite file for development. Production (M8) uses Postgres.
DATABASE_URL=sqlite+aiosqlite:///./reminderbot.db

# --- Behaviour ---
DEFAULT_TIMEZONE=Africa/Accra
SCHEDULER_INTERVAL_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
# true = one JSON object per line (good for servers), false = readable console output
LOG_JSON=false
